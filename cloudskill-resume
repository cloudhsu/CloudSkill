#!/usr/bin/env bash
# CloudSkill interruption-safe continuation command.
# Run from the repository root or any subdirectory:
#   ./cloudskill-resume
#   ./cloudskill-resume --status

set -Eeuo pipefail

MODE="resume"
FORCE_EVAL=0
SKIP_EVAL=0
NO_PUSH=0
NO_WATCH=0
EVAL_PROVIDER="ollama"
COMMIT_MESSAGE="feat: continue CloudSkill lifecycle and runtime evaluation"

usage() {
  cat <<'EOF'
Usage: ./cloudskill-resume [options]

Options:
  --status       Show the current branch, Eval, ZIP, PR, and stash state only.
  --force-eval   Run a new local Runtime Eval even when a current ZIP is reusable.
  --skip-eval    Continue validation/commit/push/PR without running a model.
  --provider NAME Select local Eval provider: ollama or codex. Default: ollama.
  --codex        Shortcut for --provider codex.
  --no-push      Stop after local validation and commit.
  --no-watch     Do not wait for GitHub Actions after creating/finding the PR.
  --message TEXT Override the Git commit subject.
  -h, --help     Show this help.

The command is restart-safe:
- it never reapplies or drops Git stashes;
- it refuses to launch a second Runtime Eval while one is active;
- it reuses a completed ZIP when its source snapshot still matches;
- it can continue after interruption at validation, Eval, commit, push, PR, or CI.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --status)
      MODE="status"
      shift
      ;;
    --force-eval)
      FORCE_EVAL=1
      shift
      ;;
    --skip-eval)
      SKIP_EVAL=1
      shift
      ;;
    --provider)
      [ "$#" -ge 2 ] || { echo "ERROR: --provider requires ollama or codex." >&2; exit 2; }
      EVAL_PROVIDER="$2"
      case "$EVAL_PROVIDER" in ollama|codex) ;; *) echo "ERROR: invalid provider: $EVAL_PROVIDER" >&2; exit 2 ;; esac
      shift 2
      ;;
    --codex)
      EVAL_PROVIDER="codex"
      shift
      ;;
    --no-push)
      NO_PUSH=1
      shift
      ;;
    --no-watch)
      NO_WATCH=1
      shift
      ;;
    --message)
      [ "$#" -ge 2 ] || { echo "ERROR: --message requires text." >&2; exit 2; }
      COMMIT_MESSAGE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "ERROR: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ] && [ -d "$SCRIPT_DIR/.git" ]; then
  ROOT="$SCRIPT_DIR"
fi
[ -n "$ROOT" ] && [ -d "$ROOT/.git" ] || {
  echo "ERROR: Run this command inside a CloudSkill Git repository." >&2
  exit 2
}
cd "$ROOT"

STATE_DIR="$ROOT/.local/cloudskill-resume"
LOCK_DIR="$STATE_DIR/lock"
STATUS_FILE="$STATE_DIR/STATUS.txt"
mkdir -p "$STATE_DIR"

if [ -d "$LOCK_DIR" ]; then
  old_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
  if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
    echo "A CloudSkill resume process is already running (PID $old_pid)."
    echo "State: $STATUS_FILE"
    exit 0
  fi
  rm -rf "$LOCK_DIR"
fi
mkdir "$LOCK_DIR"
echo "$$" > "$LOCK_DIR/pid"

STAMP="$(date +%Y%m%d-%H%M%S)"
LOG_FILE="$STATE_DIR/resume-$STAMP.log"
STAGE="initialize"
FINAL_CODE=0

write_state() {
  {
    echo "stage=$STAGE"
    echo "updated=$(date '+%Y-%m-%d %H:%M:%S')"
    echo "repository=$ROOT"
    echo "branch=$(git branch --show-current 2>/dev/null || true)"
    echo "head=$(git rev-parse HEAD 2>/dev/null || true)"
    echo "log=$LOG_FILE"
  } > "$STATUS_FILE"
}

finish() {
  FINAL_CODE=$?
  write_state
  rm -rf "$LOCK_DIR"
  if [ "$FINAL_CODE" -ne 0 ]; then
    echo
    echo "Interrupted or failed at stage: $STAGE"
    echo "Resume from the current folder with:"
    echo "  ./cloudskill-resume"
    echo "Log: $LOG_FILE"
  fi
  exit "$FINAL_CODE"
}
trap finish EXIT
trap 'STAGE="interrupted-SIGINT"; exit 130' INT
trap 'STAGE="interrupted-SIGTERM"; exit 143' TERM

exec > >(tee -a "$LOG_FILE") 2>&1
write_state

find_python() {
  local candidate
  for candidate in \
    "${CLOUDSKILL_PYTHON:-}" \
    /usr/local/opt/python@3.13/bin/python3.13 \
    /usr/local/opt/python@3.12/bin/python3.12 \
    /usr/local/opt/python@3.11/bin/python3.11 \
    /usr/local/bin/python3.13 \
    /usr/local/bin/python3.12 \
    /usr/local/bin/python3.11 \
    /opt/homebrew/bin/python3.13 \
    /opt/homebrew/bin/python3.12 \
    /opt/homebrew/bin/python3.11 \
    /Library/Frameworks/Python.framework/Versions/3.13/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 \
    /Library/Frameworks/Python.framework/Versions/3.11/bin/python3
  do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      if "$candidate" -c \
        'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
        >/dev/null 2>&1
      then
        printf '%s\n' "$candidate"
        return 0
      fi
    fi
  done

  for candidate in python3.13 python3.12 python3.11 python3.10 python3; do
    candidate="$(command -v "$candidate" 2>/dev/null || true)"
    if [ -n "$candidate" ] && "$candidate" -c \
      'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
      >/dev/null 2>&1
    then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

latest_review_zip() {
  local candidate=""
  if [ -f ".local/runtime-evals/LATEST_REVIEW_ZIP.txt" ]; then
    candidate="$(head -1 ".local/runtime-evals/LATEST_REVIEW_ZIP.txt" | tr -d '\r')"
  fi
  if [ -z "$candidate" ] || [ ! -s "$candidate" ]; then
    candidate="$(
      find ".local/runtime-evals" -maxdepth 1 -type f \
        -name 'CloudSkill-local-eval-review-local-review-*.zip' \
        -print 2>/dev/null | sort | tail -1
    )"
  fi
  printf '%s\n' "$candidate"
}

active_eval_processes() {
  pgrep -fl 'scripts/(run_local_eval_review|run_runtime_evals)\.py' 2>/dev/null || true
}

show_status() {
  local branch zip active
  branch="$(git branch --show-current)"
  zip="$(latest_review_zip)"
  active="$(active_eval_processes)"

  echo "CloudSkill continuation status"
  echo "Repository: $ROOT"
  echo "Branch: $branch"
  echo "HEAD: $(git log -1 --oneline)"
  echo
  echo "Worktree:"
  git status -sb
  echo
  echo "Runtime Eval:"
  if [ -n "$active" ]; then
    echo "$active"
  else
    echo "No active Runtime Eval process."
  fi
  echo
  echo "Latest review ZIP:"
  if [ -n "$zip" ] && [ -s "$zip" ]; then
    echo "$zip"
  else
    echo "No completed review ZIP found."
  fi
  echo
  echo "Preserved stashes:"
  git stash list --date=local | head -5 || true
  echo
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    echo "Pull request:"
    gh pr view "$branch" --json number,state,isDraft,url,statusCheckRollup \
      --jq '{number,state,isDraft,url,checks:[.statusCheckRollup[]? | {name:.name,status:.status,conclusion:.conclusion}]}' \
      2>/dev/null || echo "No PR found for this branch."
  else
    echo "GitHub CLI is unavailable or not authenticated."
  fi
}

if [ "$MODE" = "status" ]; then
  STAGE="status"
  show_status
  exit 0
fi

PYTHON="$(find_python || true)"
[ -n "$PYTHON" ] || {
  echo "ERROR: Python 3.10 or newer was not found." >&2
  exit 2
}

echo "CloudSkill interruption-safe continuation"
echo "Repository: $ROOT"
echo "Branch: $(git branch --show-current)"
echo "Python: $PYTHON"
echo "Eval provider: $EVAL_PROVIDER"
"$PYTHON" --version
echo "Log: $LOG_FILE"

STAGE="active-process-check"
write_state
ACTIVE="$(active_eval_processes)"
if [ -n "$ACTIVE" ]; then
  echo
  echo "A Runtime Eval is still active:"
  echo "$ACTIVE"
  LATEST_RUN="$(
    find ".local/runtime-evals" -maxdepth 1 -type d \
      -name 'local-review-*' -print 2>/dev/null | sort | tail -1
  )"
  if [ -n "$LATEST_RUN" ] && [ -f "$LATEST_RUN/run.log" ]; then
    echo
    echo "Latest log: $LATEST_RUN/run.log"
    tail -30 "$LATEST_RUN/run.log"
  fi
  echo
  echo "No second model run was started."
  echo "Run ./cloudskill-resume again after the process ends."
  exit 0
fi

STAGE="static-validation"
write_state
echo
echo "=== Static validation ==="
if [ -f "scripts/manage_skill.py" ]; then
  "$PYTHON" scripts/manage_skill.py refresh --all
  "$PYTHON" scripts/manage_skill.py audit --check
fi
"$PYTHON" scripts/run_all_checks.py
git diff --check

zip_matches_current_sources() {
  local zip="$1"
  local expected_provider="$2"
  [ -n "$zip" ] && [ -s "$zip" ] || return 1

  "$PYTHON" - "$zip" "$ROOT" "$expected_provider" <<'PY'
from __future__ import annotations

import hashlib
import json
import sys
import zipfile
from pathlib import Path

zip_path = Path(sys.argv[1])
root = Path(sys.argv[2])
expected_provider = sys.argv[3]
prefix = "CloudSkill-local-eval-review/"

def digest(path: Path) -> str:
    value = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            value.update(chunk)
    return value.hexdigest()

try:
    with zipfile.ZipFile(zip_path) as archive:
        status = json.loads(archive.read(prefix + "STATUS.json"))
        inventory = json.loads(archive.read(prefix + "source-inventory.json"))
except (OSError, KeyError, ValueError, zipfile.BadZipFile):
    raise SystemExit(1)

if status.get("pipeline_status") != "SUCCESS":
    raise SystemExit(1)
actual_provider = status.get("provider") or "ollama"
if actual_provider != expected_provider:
    raise SystemExit(1)

checked = 0
for item in inventory:
    if not item.get("included"):
        continue
    relative = item.get("path")
    expected = item.get("sha256")
    if not isinstance(relative, str) or not isinstance(expected, str):
        continue
    current = root / relative
    if not current.is_file() or digest(current) != expected:
        raise SystemExit(1)
    checked += 1

raise SystemExit(0 if checked else 1)
PY
}

REVIEW_ZIP="$(latest_review_zip)"

STAGE="runtime-eval"
write_state
echo
echo "=== Runtime Eval evidence ==="
if [ "$SKIP_EVAL" -eq 1 ]; then
  echo "Runtime Eval skipped by --skip-eval."
elif [ "$FORCE_EVAL" -eq 0 ] && zip_matches_current_sources "$REVIEW_ZIP" "$EVAL_PROVIDER"; then
  echo "Reusing the completed review ZIP because its source hashes still match:"
  echo "$REVIEW_ZIP"
else
  [ -x "./cloudskill-eval" ] || {
    echo "ERROR: ./cloudskill-eval is missing or not executable." >&2
    exit 2
  }
  echo "Starting exactly one foreground Runtime Eval with provider: $EVAL_PROVIDER"
  if [ "$EVAL_PROVIDER" = "codex" ]; then
    [ -x "./cloudskill-eval-codex" ] || {
      echo "ERROR: ./cloudskill-eval-codex is missing or not executable." >&2
      exit 2
    }
    ./cloudskill-eval-codex
  else
    ./cloudskill-eval
  fi
  REVIEW_ZIP="$(latest_review_zip)"
  [ -n "$REVIEW_ZIP" ] && [ -s "$REVIEW_ZIP" ] || {
    echo "ERROR: Runtime Eval did not produce a valid review ZIP." >&2
    exit 2
  }
fi

if [ -n "$REVIEW_ZIP" ] && [ -s "$REVIEW_ZIP" ]; then
  echo "Review ZIP: $REVIEW_ZIP"
else
  echo "Review ZIP: not available"
fi

FORMAL_PATHS=(
  ".agents"
  ".github"
  "config"
  "evals"
  "scripts"
  "docs"
  "SKILL_MANIFEST.json"
  "cloudskill-eval"
  "cloudskill-eval-codex"
  "cloudskill-resume"
  "README.md"
  "CHANGELOG.md"
  "VERSION"
  "AGENTS.md"
  "CLAUDE.md"
  "INSTALL.md"
  "PLANS.md"
)

STAGE="stage"
write_state
echo
echo "=== Stage formal changes ==="
existing_paths=()
for path in "${FORMAL_PATHS[@]}"; do
  if [ -e "$path" ] || git ls-files --error-unmatch "$path" >/dev/null 2>&1; then
    existing_paths+=("$path")
  fi
done
git add -A -- "${existing_paths[@]}"
git diff --cached --check

BRANCH="$(git branch --show-current)"
if ! git diff --cached --quiet && { [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; }; then
  BRANCH="fix/cloudskill-resume-$STAMP"
  git switch -c "$BRANCH"
  echo "Created review branch: $BRANCH"
fi

STAGE="commit"
write_state
if ! git diff --cached --quiet; then
  git diff --cached --stat
  git commit -m "$COMMIT_MESSAGE"
else
  echo "No formal changes remain to commit."
fi

BRANCH="$(git branch --show-current)"
if [ "$NO_PUSH" -eq 1 ]; then
  STAGE="local-complete"
  echo
  echo "Push skipped by --no-push."
  echo "Branch: $BRANCH"
  exit 0
fi

if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  STAGE="main-no-push"
  echo
  echo "No review branch exists and no formal changes required a commit."
  echo "Nothing was pushed to $BRANCH."
  exit 0
fi

STAGE="push"
write_state
echo
echo "=== Push branch ==="
git push -u origin "$BRANCH"

STAGE="pull-request"
write_state
echo
echo "=== Pull request ==="
PR_URL=""
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  PR_URL="$(gh pr view "$BRANCH" --json url --jq .url 2>/dev/null || true)"
  if [ -z "$PR_URL" ]; then
    PR_BODY="$STATE_DIR/pr-body-$STAMP.md"
    {
      echo "## Summary"
      echo
      echo "- Continue the interrupted CloudSkill lifecycle and Runtime Eval workflow"
      echo "- Preserve one-command local validation and review-bundle generation"
      echo "- Keep local stashes and private .local evidence outside the commit"
      echo
      echo "## Validation"
      echo
      echo "- Repository static checks: passed"
      if [ -n "$REVIEW_ZIP" ] && [ -s "$REVIEW_ZIP" ]; then
        echo "- Local Runtime Eval provider: $EVAL_PROVIDER"
      echo "- Local Runtime Eval review bundle: $(basename "$REVIEW_ZIP")"
      else
        echo "- Local Runtime Eval: skipped"
      fi
    } > "$PR_BODY"

    PR_URL="$(
      gh pr create \
        --draft \
        --base main \
        --head "$BRANCH" \
        --title "$COMMIT_MESSAGE" \
        --body-file "$PR_BODY"
    )"
  fi
  echo "PR: $PR_URL"

  if [ "$NO_WATCH" -eq 0 ]; then
    STAGE="github-actions"
    write_state
    gh pr checks --watch || true
  fi
else
  COMPARE_URL="https://github.com/cloudhsu/CloudSkill/compare/main...$BRANCH?expand=1"
  echo "GitHub CLI is unavailable or not authenticated."
  echo "Create or inspect the PR here:"
  echo "$COMPARE_URL"
  command -v open >/dev/null 2>&1 && open "$COMPARE_URL" >/dev/null 2>&1 || true
fi

STAGE="completed"
write_state
echo
echo "============================================================"
echo "CLOUDSKILL CONTINUATION COMPLETED"
echo "Branch: $BRANCH"
[ -n "$REVIEW_ZIP" ] && echo "Review ZIP: $REVIEW_ZIP"
[ -n "$PR_URL" ] && echo "PR: $PR_URL"
echo "Preserved stashes were not applied or dropped:"
git stash list --date=local | head -5 || true
echo "Log: $LOG_FILE"
echo "============================================================"

if [ -n "$REVIEW_ZIP" ] && [ -s "$REVIEW_ZIP" ] && command -v open >/dev/null 2>&1; then
  open -R "$REVIEW_ZIP" >/dev/null 2>&1 || true
fi
