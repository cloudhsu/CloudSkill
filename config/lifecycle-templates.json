{
  "schema_version": 1,
  "required_consumer_paths": [
    "scripts/lifecycle_template_contract.py"
  ],
  "templates": {
    "lightweight-change": {
      "template_id": "lightweight-change",
      "status": "implemented",
      "contract_version": 1,
      "applicability": {
        "scope": "local",
        "risk": "low",
        "reversible": true
      },
      "exclusions": [
        "material semantic change",
        "authority or durable-state change",
        "security, privacy, platform, deployment, or external-side-effect change"
      ],
      "stages": [
        "analyze",
        "implement",
        "verify"
      ],
      "gates": [
        {
          "gate_id": "scope-and-delta",
          "required_evidence": [
            "bounded delta record"
          ]
        },
        {
          "gate_id": "verification",
          "required_evidence": [
            "focused verification result"
          ]
        }
      ],
      "owners": {
        "lifecycle_plan": "development-process-tailoring",
        "state": "existing-lifecycle-orchestration",
        "policy": "development-process-tailoring",
        "action": "task-execution-owner",
        "evidence": "verification-owner"
      },
      "required_evidence": [
        "normalized task facts",
        "all-false bounded delta record",
        "focused verification result"
      ],
      "review_level": "L0_SINGLE_REVIEW",
      "resume_reconciliation": {
        "checkpoint_owner": "existing-lifecycle-orchestration",
        "interruption_rule": "reconcile durable state before resuming"
      },
      "reuse_invalidation": {
        "reuse_when": [
          "task facts, source, contract, and risk remain equivalent"
        ],
        "invalidate_when": [
          "any matched condition or bounded delta changes"
        ]
      },
      "compatible_overlays": [],
      "escalation_conditions": [
        "a bounded delta is true or unknown",
        "a positive applicability condition no longer matches",
        "authority, evidence identity, or reconciliation is ambiguous"
      ]
    },
    "bounded-feature": {
      "template_id": "bounded-feature",
      "status": "implemented",
      "contract_version": 1,
      "applicability": {
        "scope": "bounded",
        "design_approved": true,
        "owners_known": true,
        "reversible": true,
        "automated_verification_available": true
      },
      "exclusions": [
        "unapproved design",
        "unknown owner or authority boundary",
        "irreversible or unreconciled outcome"
      ],
      "stages": [
        "analyze",
        "design",
        "implement",
        "verify",
        "release"
      ],
      "gates": [
        {
          "gate_id": "approved-design",
          "required_evidence": [
            "approved design and owner record"
          ]
        },
        {
          "gate_id": "verification",
          "required_evidence": [
            "automated verification result"
          ]
        }
      ],
      "owners": {
        "lifecycle_plan": "development-process-tailoring",
        "state": "existing-lifecycle-orchestration",
        "policy": "development-process-tailoring",
        "action": "task-execution-owner",
        "evidence": "verification-owner"
      },
      "required_evidence": [
        "approved design",
        "known-owner record",
        "normalized task facts",
        "bounded delta record",
        "automated verification result"
      ],
      "review_level": "L2_SINGLE_FAMILY_QUAD",
      "resume_reconciliation": {
        "checkpoint_owner": "existing-lifecycle-orchestration",
        "interruption_rule": "reconcile durable state and plan revision before resuming"
      },
      "reuse_invalidation": {
        "reuse_when": [
          "approved design, source, contract, and risk remain equivalent"
        ],
        "invalidate_when": [
          "design, owner, delta, or plan revision changes"
        ]
      },
      "compatible_overlays": [
        "skill-evolution"
      ],
      "escalation_conditions": [
        "a bounded delta is true or unknown",
        "approved design or owner evidence is stale",
        "a required overlay conflicts with an owner or gate"
      ]
    },
    "skill-evolution": {
      "template_id": "skill-evolution",
      "status": "implemented",
      "contract_version": 1,
      "applicability": {
        "work_type": "skill_evolution",
        "sanitization_required": true,
        "adjacent_regression_required": true
      },
      "exclusions": [
        "unsanitized private evidence",
        "missing RED baseline evidence",
        "release claim without execution evidence"
      ],
      "stages": [
        "analyze",
        "verify",
        "implement",
        "verify",
        "release",
        "learn"
      ],
      "gates": [
        {
          "gate_id": "evidence-inventory",
          "required_evidence": [
            "sanitized and deduplicated evidence inventory"
          ]
        },
        {
          "gate_id": "red-green-regression",
          "required_evidence": [
            "RED result",
            "minimum change",
            "GREEN and adjacent regression result"
          ]
        }
      ],
      "owners": {
        "lifecycle_plan": "development-process-tailoring",
        "state": "existing-lifecycle-orchestration",
        "policy": "developing-skills",
        "action": "skill-change-owner",
        "evidence": "developing-skills"
      },
      "required_evidence": [
        "sanitized and deduplicated evidence inventory",
        "owner selection",
        "RED baseline result",
        "minimum change record",
        "GREEN and adjacent regression result",
        "review and release-boundary decision"
      ],
      "review_level": "L3_SINGLE_FAMILY_PAIR",
      "resume_reconciliation": {
        "checkpoint_owner": "existing-lifecycle-orchestration",
        "interruption_rule": "reconcile evidence lineage and completed RED/GREEN gates before resuming"
      },
      "reuse_invalidation": {
        "reuse_when": [
          "evidence scope, source, contract, rubric, environment, and risk remain equivalent"
        ],
        "invalidate_when": [
          "Skill text, Eval, contract, source, rubric, environment, or risk changes"
        ]
      },
      "compatible_overlays": [],
      "escalation_conditions": [
        "a bounded delta is true or unknown",
        "sanitization, owner, or evidence validity is ambiguous",
        "the change requires a deferred lifecycle template"
      ]
    },
    "iterative-discovery": {
      "template_id": "iterative-discovery",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "architecture-change": {
      "template_id": "architecture-change",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "brownfield-refactor": {
      "template_id": "brownfield-refactor",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "hotfix": {
      "template_id": "hotfix",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "release": {
      "template_id": "release",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "hardware-integration": {
      "template_id": "hardware-integration",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    },
    "incident-recovery": {
      "template_id": "incident-recovery",
      "status": "deferred",
      "contract_version": 1,
      "deferred_reason": "Requires its own RED contract, validator, and behavior evidence."
    }
  }
}
