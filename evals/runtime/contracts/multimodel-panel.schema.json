{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudskill.local/evals/runtime/contracts/multimodel-panel.schema.json",
  "title": "CloudBox reproducible multi-model panel record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "panel_id", "status", "identity_map_hash", "adjudication_path", "workers"],
  "properties": {
    "schema_version": {"const": 1},
    "panel_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["COMPLETE_2X2", "DEGRADED", "INCOMPLETE", "BLOCKED"]},
    "identity_map_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adjudication_path": {"type": "string", "minLength": 1},
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "blind_label", "family", "role", "provider", "requested_model", "canonical_model", "status", "output_path", "packet_hash", "prompt_hash", "raw_output_hash", "adapter_version", "transport_mode", "tokens", "latency_ms", "attempts", "retries", "fallback", "fallback_prompt_hash", "failure_layer", "verdict", "findings_path", "cost"],
        "properties": {
          "worker_id": {"type": "string", "minLength": 1},
          "blind_label": {"type": "string", "minLength": 1},
          "family": {"enum": ["gpt", "claude"]},
          "role": {"enum": ["efficient", "frontier"]},
          "provider": {"type": "string", "minLength": 1},
          "requested_model": {"type": "string", "minLength": 1},
          "canonical_model": {"type": ["string", "null"]},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "MANUAL_REQUIRED"]},
          "output_path": {"type": "string", "minLength": 1},
          "packet_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "prompt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "raw_output_hash": {"type": ["string", "null"]},
          "adapter_version": {"type": "string", "minLength": 1},
          "transport_mode": {"type": "string", "minLength": 1},
          "tokens": {
            "type": "object", "additionalProperties": false,
            "required": ["input", "cache", "output", "reasoning"],
            "properties": {
              "input": {"type": "integer", "minimum": 0}, "cache": {"type": "integer", "minimum": 0},
              "output": {"type": "integer", "minimum": 0}, "reasoning": {"type": "integer", "minimum": 0}
            }
          },
          "latency_ms": {"type": "integer", "minimum": 0},
          "attempts": {"type": "integer", "minimum": 0, "maximum": 2},
          "retries": {"type": "integer", "minimum": 0, "maximum": 1},
          "fallback": {"type": ["string", "null"]},
          "fallback_prompt_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "failure_layer": {"type": ["string", "null"]},
          "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "MANUAL_REQUIRED"]},
          "findings_path": {"type": "string", "minLength": 1},
          "cost": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "amount", "currency"],
                "properties": {
                  "kind": {"enum": ["provider_reported", "estimated", "usage_only"]},
                  "amount": {"type": "number", "minimum": 0},
                  "currency": {"type": "string", "minLength": 1},
                  "estimate_source": {"type": "string", "minLength": 1},
                  "estimate_date": {"type": "string", "format": "date"}
                }
              }
            ]
          }
        }
      }
    }
  }
}
