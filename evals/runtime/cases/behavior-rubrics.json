{
  "schema_version": 1,
  "description": "Deterministic coverage-oriented Behavior Eval rubrics. These scores measure explicit engineering evidence in model output, not complete semantic correctness.",
  "cases": {
    "PMS-R01-idempotent-reconciliation": {
      "passing_score": 80,
      "criteria": [
        {"id":"inventory","label":"Complete target enumeration before mutation","weight":20,"all_groups":[["complete|全(部|量)|enumerat|列舉|inventory"],["pagination|分頁|scope|範圍"]]},
        {"id":"identity","label":"Stable identity and duplicate prevention","weight":20,"all_groups":[["source[_ -]?key|remote[_ -]?id|mapping|來源鍵|遠端 ID"],["duplicate|去重|no duplicates|不重複"]]},
        {"id":"plan","label":"Explicit reconciliation plan and counts","weight":20,"all_groups":[["no-op|create|update|ambiguous|blocked"],["plan|計畫|count|數量"]]},
        {"id":"readback","label":"Post-write authoritative verification","weight":20,"all_groups":[["re-read|read back|GET|重新讀取|讀回"],["verify|驗證|authoritative|權威"]]},
        {"id":"privacy","label":"No real credentials or identities in output","weight":20,"all_groups":[["credential|憑證|token|secret"],["redact|遮蔽|placeholder|佔位符|不輸出"]]}
      ],
      "penalties": [
        {"id":"blind-create","label":"Blind creation or local-only success","points":25,"trigger_patterns":["blind.{0,20}(create|建立)|only.*2xx|local.*success"],"unless_patterns":["do not|不得|不應|禁止|not sufficient"]},
        {"id":"identity-leak","label":"Unnecessary real identity","points":25,"trigger_patterns":["[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.(?!invalid\\b)[A-Za-z]{2,}|真實.*(人|信箱|帳號)"],"unless_patterns":["example\\.invalid|actor@example\\.invalid"]}
      ]
    },
    "PMS-R02-version-and-secret-boundary": {
      "passing_score": 80,
      "criteria": [
        {"id":"secret-store","label":"OS-specific SecretStore boundary","weight":20,"all_groups":[["SecretStore"],["Keychain|Credential Manager|DPAPI|libsecret|Secret Service|CI secret"]]},
        {"id":"adapter","label":"Versioned provider adapters","weight":20,"all_groups":[["adapter|適配器"],["version|版本|API family"]]},
        {"id":"capability","label":"Capability discovery and fail-closed writes","weight":20,"all_groups":[["capabilit|能力|discovery|探測"],["read-only|唯讀|fail closed|禁止寫入|blocked"]]},
        {"id":"redaction","label":"Credential and identity redaction","weight":20,"all_groups":[["redact|遮蔽"],["token|Bearer|email|credential|憑證"]]},
        {"id":"platform","label":"macOS Windows Ubuntu distinction","weight":20,"all_groups":[["macOS|Windows|Ubuntu|Linux"],["platform|平台|cross-platform|跨平台"]]}
      ],
      "penalties": [
        {"id":"plaintext","label":"Plaintext credential default","points":25,"trigger_patterns":["default.*(plaintext|明文)|明文.*(預設|默认)"],"unless_patterns":["not|不得|禁止|off|關閉"]}
      ]
    },
    "PMS-R03-generic-api-counterexample": {
      "passing_score": 80,
      "criteria": [
        {"id":"api","label":"Generic client/server API boundary","weight":34,"all_groups":[["API|REST|HTTP"],["client|server|application service"]]},
        {"id":"authority","label":"Authorization and server authority","weight":33,"all_groups":[["RBAC|authorization|授權"],["server|伺服器|authority|權威"]]},
        {"id":"transaction","label":"Transaction and failure semantics","weight":33,"all_groups":[["transaction|交易"],["rollback|idempot|timeout|逾時|回滾"]]}
      ],
      "penalties": [
        {"id":"wrong-route","label":"Unnecessary project-management synchronization","points":25,"trigger_patterns":["Vikunja|OpenProject|Redmine|project-management-sync|專案管理.*同步"],"unless_patterns":["not.*(involved|execute|run)|未執行|不執行|不要.*執行|不.*涉及|out of scope"]}
      ]
    },
    "PMS-R04-unknown-version-read-only": {
      "passing_score": 80,
      "criteria": [
        {"id":"read-only","label":"Unknown version/capability forces read-only or manual review","weight":25,"all_groups":[["read-only|唯讀|audit|稽核|manual review|人工審查"],["unknown|不明|超出|unsupported|不可用"]]},
        {"id":"missing-evidence","label":"Names missing compatibility evidence","weight":25,"all_groups":[["capabilit|能力|discovery|探測"],["unavailable|不可用|missing|缺少|contract test|契約測試"]]},
        {"id":"write-block","label":"Blocks mutations until adapter and contract gates pass","weight":25,"all_groups":[["prohibit|禁止|block|阻止|不得"],["create|update|delete|建立|更新|刪除"]]},
        {"id":"no-inference","label":"Does not infer compatibility from HTTP success or URL shape","weight":25,"all_groups":[["2xx|200|成功回應|URL|網址"],["不能|不可|不得|not|infer|推論"]]}
      ],
      "penalties": [
        {"id":"unknown-version-write","label":"Writes against an unknown or unreviewed version","points":30,"trigger_patterns":["(create|update|delete|建立|更新|刪除).{0,60}(unknown|unsupported|不明|未支援|超出)"],"unless_patterns":["prohibit|禁止|block|不得|不允許"]}
      ]
    },
    "R07-english-equipment-architecture": {
      "title": "Distributed equipment ownership and recovery model",
      "passing_score": 75,
      "criteria": [
        {
          "id": "state-authority",
          "label": "Defines authoritative state ownership per chamber/IPC",
          "weight": 12,
          "all_groups": [
            [
              "authoritative state",
              "state authority",
              "owns? (?:the )?(?:chamber )?state",
              "sole authority",
              "authority matrix"
            ],
            [
              "\\bIPC\\b",
              "chamber"
            ],
            [
              "readback",
              "actual state",
              "physical state",
              "sensor"
            ]
          ],
          "max_span": 600
        },
        {
          "id": "shared-resource-ownership",
          "label": "Defines one owner and reservation/arbitration for shared transfer resources",
          "weight": 12,
          "all_groups": [
            [
              "shared (?:transfer )?resource",
              "transfer robot",
              "shared robot",
              "resource manager"
            ],
            [
              "reservation",
              "arbitration",
              "lease",
              "single owner",
              "resource owner"
            ]
          ],
          "max_span": 600
        },
        {
          "id": "reconnect-reconciliation",
          "label": "Requires state reconciliation after reconnect before accepting new work",
          "weight": 12,
          "all_groups": [
            [
              "reconnect",
              "reconnection"
            ],
            [
              "reconcil",
              "reconstruct",
              "compare.*readback",
              "refresh.*state",
              "stale session"
            ],
            [
              "before (?:accepting|issuing|new)",
              "block.*command",
              "do not accept",
              "gate.*command",
              "until.*reconcil"
            ]
          ],
          "max_span": 2000
        },
        {
          "id": "restart-reconstruction",
          "label": "Reconstructs physical/material state after restart",
          "weight": 12,
          "all_groups": [
            [
              "restart",
              "reboot",
              "process restart"
            ],
            [
              "reconstruct",
              "reconcil",
              "query.*hardware",
              "read back",
              "readback.*before"
            ],
            [
              "wafer (?:identity|location)",
              "occupancy",
              "physical(?:[/ ])?(?:material )?state",
              "sensor state"
            ]
          ],
          "max_span": 600
        },
        {
          "id": "failover-fencing",
          "label": "Defines failover authority transfer and split-brain prevention",
          "weight": 14,
          "all_groups": [
            [
              "failover",
              "takeover"
            ],
            [
              "fenc",
              "epoch",
              "lease",
              "single writer",
              "single owner",
              "authority transfer",
              "split[- ]brain",
              "quorum"
            ],
            [
              "old owner",
              "former owner",
              "previous owner",
              "stale owner",
              "dual owner",
              "duplicate owner",
              "exclusive"
            ]
          ],
          "max_span": 800
        },
        {
          "id": "command-event-lifecycle",
          "label": "Covers command identity, duplicate/idempotency and late completion",
          "weight": 12,
          "all_groups": [
            [
              "command",
              "event"
            ],
            [
              "correlation",
              "request id",
              "command id",
              "attempt id",
              "identity"
            ],
            [
              "idempot",
              "duplicate",
              "late completion",
              "late response",
              "timeout"
            ]
          ],
          "max_span": 800
        },
        {
          "id": "interlock-readiness",
          "label": "Revalidates interlocks/readiness using current evidence",
          "weight": 10,
          "all_groups": [
            [
              "interlock",
              "readiness",
              "safe(?:ty)? condition"
            ],
            [
              "revalid",
              "current readback",
              "current state",
              "sensor evidence",
              "physical evidence"
            ]
          ],
          "max_span": 600
        },
        {
          "id": "verification-scenarios",
          "label": "Defines concrete failure and recovery verification scenarios",
          "weight": 8,
          "all_groups": [
            [
              "(?:test|verify)\\s+(?:that|by|with|using|a|an|the).{0,250}(?:disconnect|restart|duplicate|out[- ]of[- ]order|owner loss|failover|late completion)",
              "(?:inject|simulate)\\s+(?:a |an )?(?:disconnect|restart|duplicate|out[- ]of[- ]order|owner loss|failover|late completion)",
              "\\b\\d{1,2}\\.\\s+[A-Z][a-z]+.{0,200}?\\bExpect\\b",
              "\\b\\d{1,2}\\.\\s+\\*{0,2}[A-Z][^\\n]{2,200}\\*{0,2}.{0,500}?\\bExpected?\\s*:"
            ]
          ],
          "max_span": 1000000
        },
        {
          "id": "assumptions-unknowns",
          "label": "Separates assumptions and unresolved design inputs",
          "weight": 4,
          "all_groups": [
            [
              "(?:^|\\n)[ \\t]*(?:[-*#>]{1,3}|\\d{1,2}[.)])?[ \\t]*\\**[ \\t]*(?:assumptions?|unknowns?|unresolved(?: inputs| questions)?)\\b",
              "\\bassumptions?\\s*:",
              "\\bunknowns?\\s*:",
              "requires confirmation",
              "not specified"
            ]
          ],
          "max_span": 1000000
        },
        {
          "id": "final-answer-discipline",
          "label": "Returns a final deliverable without exposing internal planning or Eval machinery",
          "weight": 4,
          "all_groups": [
            [
              ".{500,}"
            ]
          ],
          "must_not_match": [
            "\\blet me (?:analyze|think|draft)",
            "\\bi need to\\b",
            "the router has already selected",
            "\\bSKILL\\.md\\b",
            "\\bcase id\\b",
            "i'll focus on",
            "let me structure",
            "\\bwe (?:are given|must|need to|should|will)\\b",
            "\\bkey requirements\\b",
            "\\bstructure (?:the|this) deliverable\\b",
            "\\blet(?:'|’)s draft\\b",
            "\\bwe are to return\\b",
            "\\bthe (?:problem|prompt) says\\b"
          ],
          "max_span": 1000000
        }
      ],
      "penalties": [
        {
          "id": "unsafe-generic-failover",
          "label": "Claims simple backup switching without fencing/authority-transfer controls",
          "points": 15,
          "trigger_patterns": [
            "switch to backup resources",
            "switch(?:es)? to (?:a )?backup",
            "automatically fail(?:s)? over"
          ],
          "unless_patterns": [
            "fenc",
            "epoch",
            "single owner",
            "authority transfer",
            "split[- ]brain",
            "quorum"
          ]
        },
        {
          "id": "ack-as-completion",
          "label": "Treats transport acknowledgement as physical completion",
          "points": 20,
          "trigger_patterns": [
            "ack(?:nowledgement)? (?:means|confirms|proves).*completed",
            "success ack.*(?:open|completed|finished)"
          ],
          "unless_patterns": [
            "does not",
            "is not",
            "not proof",
            "readback",
            "physical evidence"
          ]
        }
      ]
    },
    "CAD-BEH-001": {
      "passing_score": 75,
      "criteria": [
        {"id":"staged_batches","label":"Staged, thematically-grouped batches, not one pass or file-by-file","weight":25,"all_groups":[["batch|stage|group|分批|分階段"],["theme|subsystem|module|主題|子系統"]]},
        {"id":"checkpoint","label":"Durable checkpoint after each batch before conclusions","weight":25,"all_groups":[["checkpoint|durable|resumable|crash|存檔|紀錄"],["after each|per batch|每批|每階段"]]},
        {"id":"defer_conclusion","label":"Defers cross-file conclusions until enough of the set is read","weight":25,"all_groups":[["wait|defer|hold|until enough|等|直到"],["conclusion|pattern|duplicat|結論|重複"]]},
        {"id":"map_output","label":"States the output is a maintained map/cluster list, not prose alone","weight":25,"all_groups":[["map|diagram|架構圖|地圖"],["cluster|duplicat|重複"]]}
      ],
      "penalties": [
        {"id":"jumps-to-code","label":"Starts writing the new service before surveying existing files","points":25,"trigger_patterns":["implement the (new )?service|start coding|begin writing"],"unless_patterns":["survey|read.*first|before (writing|implementing)|先.*讀|先.*調查"]}
      ]
    },
    "CAD-BEH-002": {
      "passing_score": 75,
      "criteria": [
        {"id":"empirical_verification","label":"Requires running both versions against real data/consumers, not visual similarity alone","weight":25,"all_groups":[["run|execute|test|跑|執行|測試"],["real (input|data|consumer)|actual (data|usage)|真實|實際資料"]]},
        {"id":"divergence_testing","label":"Identifies and separately tests the specific divergence points","weight":25,"all_groups":[["diverg|differ|不同|差異"],["adversarial|edge case|test|測試案例"]]},
        {"id":"transitive_search","label":"Requires a repository-wide search for the exact old name after renaming","weight":25,"all_groups":[["grep|search|搜尋|查找"],["whole|entire|repository|repo|codebase|整個|全部"]]},
        {"id":"preserve_distinction","label":"Preserves each caller's distinguishing behavior (e.g. via a parameter) rather than dropping it","weight":25,"all_groups":[["parameter|param|參數"],["preserve|keep|distinct|exception|error class|保留|區別"]]}
      ],
      "penalties": [
        {"id":"similarity-only-merge","label":"Declares the merge safe from visual similarity alone","points":30,"trigger_patterns":["(look the same|nearly identical|virtually identical).{0,80}(safe to merge|just merge|go ahead and merge)"],"unless_patterns":["run|test|verify|驗證|測試"]},
        {"id":"compile-check-sufficient","label":"Treats a passing compile/import check as proof the extraction is complete","points":20,"trigger_patterns":["compiles?( successfully| cleanly| without error)|import.{0,20}resolves? (correctly|fine|successfully)"],"unless_patterns":["not (sufficient|enough|proof)|also (search|grep|check)|不足以|還要"]}
      ]
    }
  }
}
