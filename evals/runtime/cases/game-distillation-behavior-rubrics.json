      "penalties": [
        {"id":"unsupported-success","label":"unsupported runtime claim","points":25,"trigger_patterns":["successfully (built|installed|released)|device success|fully verified"],"unless_patterns":["unknown|unverified|not run|not supplied"]}
      ]
    },
