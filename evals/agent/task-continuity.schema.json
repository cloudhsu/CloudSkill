{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudskill.local/evals/agent/task-continuity.schema.json",
  "title": "CloudBox host-level task-continuity case suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_id": {"const": "task-continuity-v1"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "nonBlankString": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "transcript", "durable_state", "authority", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^TC-[0-9]{3}$"},
        "title": {"$ref": "#/$defs/nonBlankString"},
        "kind": {"enum": ["primary", "control"]},
        "transcript": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["turn", "role", "content"],
            "properties": {
              "turn": {"type": "integer", "minimum": 1},
              "role": {"enum": ["user", "assistant", "tool"]},
              "content": {"$ref": "#/$defs/nonBlankString"}
            }
          }
        },
        "durable_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent", "source", "freshness"],
          "properties": {
            "parent": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "identified", "status"],
              "properties": {
                "id": {"type": ["string", "null"]},
                "identified": {"type": "boolean"},
                "status": {"enum": ["in_progress", "awaiting_decision", "blocked", "cancelled", "obsolete", "completed", "unknown"]}
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "identified"],
              "properties": {
                "id": {"type": ["string", "null"]},
                "kind": {"$ref": "#/$defs/nonBlankString"},
                "identified": {"type": "boolean"}
              }
            },
            "freshness": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "observed_at"],
              "properties": {
                "status": {"enum": ["fresh", "stale", "unknown"]},
                "observed_at": {"$ref": "#/$defs/nonBlankString"}
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_actions", "prohibited_actions"],
          "properties": {
            "allowed_actions": {"type": "array", "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true},
            "prohibited_actions": {"type": "array", "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parent_status", "tool_attempts", "required_outcomes", "forbidden_outcomes"],
          "properties": {
            "parent_status": {"enum": ["in_progress", "awaiting_decision", "blocked", "cancelled", "obsolete", "completed", "unknown"]},
            "tool_attempts": {"type": "array", "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true},
            "required_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true},
            "forbidden_outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlankString"}, "uniqueItems": true}
          }
        }
      },
      "x-cloudbox-invariants": [
        {"name": "sequential_turns", "path": "transcript", "field": "turn", "start": 1},
        {"name": "disjoint_arrays", "left": "authority.allowed_actions", "right": "authority.prohibited_actions", "label": "authority allowed/prohibited actions"},
        {"name": "disjoint_arrays", "left": "expected.required_outcomes", "right": "expected.forbidden_outcomes", "label": "expected outcomes"},
        {"name": "attempts_authorized", "attempts": "expected.tool_attempts", "allowed": "authority.allowed_actions", "prohibited": "authority.prohibited_actions"},
        {"name": "identified_id", "path": "durable_state.parent"},
        {"name": "identified_id", "path": "durable_state.source"}
      ]
    }
  }
}
