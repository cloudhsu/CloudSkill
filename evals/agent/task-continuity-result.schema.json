{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudskill.local/evals/agent/task-continuity-result.schema.json",
  "title": "CloudBox task-continuity structural and behavior-evidence result",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "contract_validation", "behavior_execution", "errors"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^TC-[0-9]{3}$"},
    "contract_validation": {"enum": ["PASS", "FAIL"]},
    "behavior_execution": {"enum": ["NOT RUN", "PASS", "FAIL", "BLOCKED", "MANUAL REQUIRED"]},
    "errors": {"type": "array", "items": {"$ref": "#/$defs/nonBlankDiagnostic"}}
  },
  "$defs": {
    "nonBlankDiagnostic": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
  },
  "x-cloudbox-invariants": [
    {
      "name": "result_evidence_matrix",
      "rows": [
        {"contract_validation": "PASS", "behavior_execution": "NOT RUN", "errors": "empty"},
        {"contract_validation": "PASS", "behavior_execution": "PASS", "errors": "empty"},
        {"contract_validation": "PASS", "behavior_execution": "FAIL", "errors": "nonempty"},
        {"contract_validation": "PASS", "behavior_execution": "BLOCKED", "errors": "nonempty"},
        {"contract_validation": "PASS", "behavior_execution": "MANUAL REQUIRED", "errors": "nonempty"},
        {"contract_validation": "FAIL", "behavior_execution": "NOT RUN", "errors": "nonempty"},
        {"contract_validation": "FAIL", "behavior_execution": "FAIL", "errors": "nonempty"},
        {"contract_validation": "FAIL", "behavior_execution": "BLOCKED", "errors": "nonempty"},
        {"contract_validation": "FAIL", "behavior_execution": "MANUAL REQUIRED", "errors": "nonempty"}
      ]
    }
  ]
}
