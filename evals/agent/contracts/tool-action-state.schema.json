{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudBox durable tool action state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "action_id", "idempotency_key", "plan_id", "plan_revision", "adapter_id", "adapter_version", "capability_id", "state", "attempt", "max_attempts", "input_hash", "operation_targets", "target_evidence", "authority_grant_id", "evidence", "lease"],
  "properties": {
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 0},
    "action_id": {"type": "string", "pattern": "^act-[a-z0-9][a-z0-9-]{7,63}$"},
    "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]{7,63}$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "state": {"enum": ["PLANNED", "AUTHORIZED", "RUNNING", "SUCCEEDED", "FAILED", "UNCERTAIN", "BLOCKED"]},
    "attempt": {"type": "integer", "minimum": 0},
    "max_attempts": {"type": "integer", "minimum": 1},
    "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation_targets": {"type": "object"},
    "target_evidence": {"type": "array", "maxItems": 256, "items": {"type": "object"}},
    "authority_grant_id": {"type": ["string", "null"], "pattern": "^grant-[a-z0-9][a-z0-9-]{5,63}$"},
    "evidence": {"type": "array", "maxItems": 128, "items": {"type": "object"}},
    "lease": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner_id", "fencing_token", "expires_at"],
          "properties": {
            "owner_id": {"type": "string", "minLength": 1},
            "fencing_token": {"type": "integer", "minimum": 1},
            "expires_at": {"type": "integer", "minimum": 0}
          }
        }
      ]
    }
  }
}
