{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudBox controlled tool adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "adapters"],
  "properties": {
    "schema_version": {"const": 2},
    "protocol_version": {"const": "2.0"},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/adapter"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "transport", "provenance", "capabilities"],
      "properties": {
        "adapter_id": {"$ref": "#/$defs/identifier"},
        "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "transport": {"enum": ["local-cli"]},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "sha256"],
          "properties": {
            "kind": {"const": "repository-script"},
            "path": {"type": "string", "pattern": "^scripts/[A-Za-z0-9_./-]+\\.py$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capability"}
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "risk", "required_authority", "allowed_root_refs", "secret_refs", "timeout_seconds", "max_attempts", "idempotent", "supports_reconciliation", "max_output_bytes", "target_kind", "max_target_items", "argument_schema"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/identifier"},
        "risk": {"enum": ["read-only", "local-mutating", "remote-mutating"]},
        "required_authority": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "allowed_root_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "secret_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "idempotent": {"type": "boolean"},
        "supports_reconciliation": {"type": "boolean"},
        "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
        "target_kind": {"enum": ["none", "git-fetch-refs", "eval-bundle-archives"]},
        "max_target_items": {"type": "integer", "minimum": 0, "maximum": 256},
        "argument_schema": {"type": "object"}
      }
    }
  }
}
