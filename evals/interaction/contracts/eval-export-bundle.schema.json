{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudBox Eval Export Bundle 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_format_version", "cloudbox_version", "exporter_version", "candidate_schema_version", "host", "agent_name", "export_project_name", "created_at_utc", "bundle_id", "payload_hashes"],
  "properties": {
    "bundle_format_version": {"const": "2.0"},
    "cloudbox_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "exporter_version": {"const": "2.0"},
    "candidate_schema_version": {"type": "string", "minLength": 1},
    "host": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "agent_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "export_project_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
    "created_at_utc": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z$"},
    "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "payload_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
