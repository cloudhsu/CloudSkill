{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/validate-push-readiness.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/block-push-auth-loop.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/coding-agent-git-discipline/release-cut-reminder/script.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .codex/hooks/coding-agent-git-discipline/shared-checkout-guard/script.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/record-push-outcome.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/project-management-sync/vikunja-sync-reminder/script.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
