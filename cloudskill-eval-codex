#!/bin/sh
# One-command Codex CLI Runtime Eval smoke path.
# Uses saved `codex login` authentication and the ChatGPT/Codex usage pool.

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"

if ! command -v codex >/dev/null 2>&1 && [ -z "${CLOUDSKILL_CODEX:-}" ]; then
  echo "ERROR: Codex CLI was not found."
  echo "Install Codex CLI, run: codex login"
  exit 2
fi

cd "$ROOT" || exit 2

# Defaults are intentionally quota-conscious. Later arguments override earlier ones.
exec "$ROOT/cloudskill-eval" \
  --provider codex \
  --repeat 1 \
  --no-refine \
  "$@"
